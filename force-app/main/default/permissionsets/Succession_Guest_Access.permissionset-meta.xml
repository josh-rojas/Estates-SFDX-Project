<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Guest user permissions for Succession Portal public form. DEMO-OPTIMIZED: Permissive read access for easy demonstrations. Grants access to Case, Account, Contact, and FinancialAccount objects for pathway submission. Created October 14, 2025.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Succession Guest Access</label>

    <!-- Case Object Permissions - READ ONLY for form display -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <object>Case</object>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Account Object Permissions - READ ONLY for successor info -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Contact Object Permissions - READ ONLY for successor info -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Financial Account Permissions - READ ONLY for balance display -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <object>FinServ__FinancialAccount__c</object>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Case Field Permissions - Only pathway selection fields (limited) -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Pathway_Confirmed__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Form_Completed_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Case.Form_Sent_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Case.Contact_Established__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Apex Class Access - Public form controller only -->
    <classAccesses>
        <apexClass>SuccessionPublicFormController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Page Access - Public form page only -->
</PermissionSet>
