<?xml version="1.0" encoding="UTF-8"?>
<Profile xmlns="http://soap.sforce.com/2006/04/metadata">
    <custom>false</custom>
    <description>Guest user profile for Succession Portal - token-based access only</description>
    <userLicense>Guest User License</userLicense>

    <!-- Enable Apex classes for succession form -->
    <classAccesses>
        <apexClass>SuccessionFormController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SuccessionFormTokenValidator</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Object permissions - read-only access -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Case</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>FinServ__FinancialAccount__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Field permissions for Case (succession fields) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Case.Pathway_Confirmed__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>false</editable>
        <field>Case.Form_Sent_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>false</editable>
        <field>Case.Form_Completed_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>false</editable>
        <field>Case.Contact_Established__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>false</editable>
        <field>Case.Verification_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Tab visibility -->
    <tabVisibilities>
        <tab>Succession_Form</tab>
        <visibility>DefaultOn</visibility>
    </tabVisibilities>

    <!-- Page access -->
    <pageAccesses>
        <apexPage>SuccessionFormPage</apexPage>
        <enabled>true</enabled>
    </pageAccesses>

    <!-- Login settings -->

    <!-- User permissions (minimal) -->
    <userPermissions>
        <enabled>true</enabled>
        <name>ApiEnabled</name>
    </userPermissions>
</Profile>
