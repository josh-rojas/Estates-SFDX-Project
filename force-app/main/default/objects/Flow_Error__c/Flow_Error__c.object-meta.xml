<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Logs errors from automated flows for monitoring and troubleshooting. Used by succession management flows to capture DML failures, lookup errors, and other exceptions.</description>
    <label>Flow Error</label>
    <pluralLabel>Flow Errors</pluralLabel>
    <nameField>
        <displayFormat>FE-{00000}</displayFormat>
        <label>Flow Error Number</label>
        <type>AutoNumber</type>
    </nameField>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <enableFeeds>true</enableFeeds>
    <enableHistory>true</enableHistory>
</CustomObject>
