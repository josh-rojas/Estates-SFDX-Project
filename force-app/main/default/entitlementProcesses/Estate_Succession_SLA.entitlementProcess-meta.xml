<?xml version="1.0" encoding="UTF-8" ?>
<EntitlementProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <SObjectType>Case</SObjectType>
    <active>true</active>
    <businessHours>Default</businessHours>
    <description
  >Service Level Agreements for Estate Administration / Succession Management cases. Tracks key milestones from verification through final resolution.</description>
    <entryStartDateField>CreatedDate</entryStartDateField>
    <exitCriteriaBooleanFilter />
    <exitCriteriaFilterItems>
        <field>Case.Status</field>
        <operation>equals</operation>
        <value>Closed</value>
    </exitCriteriaFilterItems>
    <exitCriteriaFilterItems>
        <field>Case.Status</field>
        <operation>equals</operation>
        <value>Canceled</value>
    </exitCriteriaFilterItems>
    <isRecordTypeApplied>false</isRecordTypeApplied>
    <isVersionDefault>false</isVersionDefault>
    <milestones>
        <businessHours>Default</businessHours>
        <milestoneCriteriaFilterItems>
            <field>Case.Verification_Status__c</field>
            <operation>equals</operation>
            <value>Complete - Verified</value>
        </milestoneCriteriaFilterItems>
        <milestoneName>Verification Complete</milestoneName>
        <minutesCustomClass />
        <minutesToComplete>1440</minutesToComplete>
        <successActions>
            <name>Update_Case_Milestone_Status</name>
            <type>FieldUpdate</type>
        </successActions>
        <timeTriggers />
        <useCriteriaStartTime>false</useCriteriaStartTime>
    </milestones>
    <milestones>
        <businessHours>Default</businessHours>
        <milestoneCriteriaFilterItems>
            <field>Case.Contact_Established__c</field>
            <operation>equals</operation>
            <value>true</value>
        </milestoneCriteriaFilterItems>
        <milestoneName>Initial Contact Established</milestoneName>
        <minutesCustomClass />
        <minutesToComplete>480</minutesToComplete>
        <timeTriggers />
        <useCriteriaStartTime>false</useCriteriaStartTime>
    </milestones>
    <milestones>
        <businessHours>Default</businessHours>
        <milestoneCriteriaFilterItems>
            <field>Case.Form_Sent_Date__c</field>
            <operation>notEqual</operation>
            <value />
        </milestoneCriteriaFilterItems>
        <milestoneName>Succession Form Sent</milestoneName>
        <minutesCustomClass />
        <minutesToComplete>1440</minutesToComplete>
        <timeTriggers />
        <useCriteriaStartTime>false</useCriteriaStartTime>
    </milestones>
    <milestones>
        <businessHours>Default</businessHours>
        <milestoneCriteriaFilterItems>
            <field>Case.Form_Completed_Date__c</field>
            <operation>notEqual</operation>
            <value />
        </milestoneCriteriaFilterItems>
        <milestoneName>Documentation Complete</milestoneName>
        <minutesCustomClass />
        <minutesToComplete>43200</minutesToComplete>
        <timeTriggers />
        <useCriteriaStartTime>false</useCriteriaStartTime>
    </milestones>
    <milestones>
        <businessHours>Default</businessHours>
        <milestoneCriteriaFilterItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>Closed</value>
        </milestoneCriteriaFilterItems>
        <milestoneName>Final Resolution</milestoneName>
        <minutesCustomClass />
        <minutesToComplete>86400</minutesToComplete>
        <timeTriggers />
        <useCriteriaStartTime>false</useCriteriaStartTime>
    </milestones>
    <name>Estate Succession SLA</name>
</EntitlementProcess>
