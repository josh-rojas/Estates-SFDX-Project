<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Admin_Email</name>
        <label>Send Admin Email</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Set_Success_True</targetReference>
        </connector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>josh.rojas.charfsc@schwab.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>⚠️ Flow Error Alert - {!varFlowName} - Severity: {!varSeverity}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>FLOW ERROR ALERT

Flow Name: {!varFlowName}
Severity: {!varSeverity}
Error Type: {!varErrorType}
Timestamp: {!varTimestamp}
Record ID: {!varRecordId}

Error Message:
{!varErrorMessage}

IMMEDIATE ACTIONS REQUIRED:
1. Review the error log record in Salesforce (ID: {!varErrorLogId})
2. Check the affected record (ID: {!varRecordId})
3. Verify succession management contact cadence is functioning
4. If critical: Manually create successor contact tasks as needed
5. Mark error as Resolved after taking corrective action

This is an automated notification from the Succession Management Error Handling Framework.</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <assignments>
