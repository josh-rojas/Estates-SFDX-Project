    <!-- Formula: Calculate Day 5 Date -->
    <formulas>
        <name>fxCalculateDay5</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!Get_Parent_Case.CreatedDate}) + 5</expression>
    </formulas>

    <!-- Formula: Calculate Day 35 Date -->
    <formulas>
        <name>fxCalculateDay35</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!Get_Parent_Case.CreatedDate}) + 35</expression>
    </formulas>

    <!-- Formula: Calculate Day 65 Date -->
    <formulas>
        <name>fxCalculateDay65</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!Get_Parent_Case.CreatedDate}) + 65</expression>
    </formulas>

    <!-- Formula: Calculate Day 95 Date -->
    <formulas>
        <name>fxCalculateDay95</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!Get_Parent_Case.CreatedDate}) + 95</expression>
    </formulas>
