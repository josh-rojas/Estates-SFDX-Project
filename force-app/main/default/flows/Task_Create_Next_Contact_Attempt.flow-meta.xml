    <!-- Decision: Check If Contact Established -->
    <decisions>
        <name>Check_If_Contact_Established</name>
        <label>Check If Contact Established</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>Contact Not Established</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Check_Attempt_Number</targetReference>
        </defaultConnector>
        <rules>
            <name>Contact_Already_Established</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_Parent_Case.Contact_Established__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Contact Already Established</label>
            <!-- Exit flow - no more tasks needed -->
        </rules>
    </decisions>

    <!-- Decision: Check Attempt Number -->
    <decisions>
        <name>Check_Attempt_Number</name>
        <label>Check Attempt Number</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <defaultConnectorLabel>Invalid Attempt</defaultConnectorLabel>
        <rules>
            <name>Is_Attempt_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_If_Attempt_2_Exists</targetReference>
            </connector>
            <label>Is Attempt 1</label>
        </rules>
        <rules>
            <name>Is_Attempt_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_If_Attempt_3_Exists</targetReference>
            </connector>
            <label>Is Attempt 2</label>
        </rules>
        <rules>
            <name>Is_Attempt_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_If_Attempt_4_Exists</targetReference>
            </connector>
            <label>Is Attempt 3</label>
        </rules>
        <rules>
            <name>Is_Attempt_4</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_If_Attempt_5_Exists</targetReference>
            </connector>
            <label>Is Attempt 4</label>
        </rules>
        <rules>
            <name>Is_Attempt_5</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <label>Is Attempt 5 (Exit)</label>
            <!-- No connector: terminal attempt, exit flow -->
        </rules>
    </decisions>

    <!-- Decision: If Attempt 2 Does Not Exist -->
    <decisions>
        <name>If_Attempt_2_Does_Not_Exist</name>
        <label>If Attempt 2 Does Not Exist</label>
        <locationX>50</locationX>
        <locationY>375</locationY>
        <defaultConnectorLabel>Task Already Exists</defaultConnectorLabel>
        <rules>
            <name>No_Attempt_2_Task_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_If_Attempt_2_Exists</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attempt_2_Task</targetReference>
            </connector>
            <label>No Attempt 2 Task Found</label>
        </rules>
    </decisions>

