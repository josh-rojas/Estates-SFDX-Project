<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description>BRD Phase 2: Automatically sends Pathway Form Invitation email when contact is established with successor. Updates Form_Sent_Date__c timestamp. Triggered when Contact_Established__c changes from FALSE to TRUE on Named Successor Enactment cases.</description>
    <environments>Default</environments>
    <interviewLabel>Case: Send Succession Form {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case: Send Succession Form</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Pathway_Form_Email</targetReference>
        </connector>
        <filterFormula>AND(
    {!$Record.RecordType.DeveloperName} = &quot;EstateAdministration&quot;,
    TEXT({!$Record.Type}) = &quot;Named Successor Enactment&quot;,
    ISCHANGED({!$Record.Contact_Established__c}),
    {!$Record.Contact_Established__c} = TRUE,
    ISBLANK({!$Record.Form_Sent_Date__c})
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>

    <!-- Send Pathway Form Invitation Email -->
    <actionCalls>
        <name>Send_Pathway_Form_Email</name>
        <label>Send Pathway Form Email</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Update_Form_Sent_Date</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Handler_Send_Email</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Contact.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Succession Pathway Information for {!$Record.Account.Name}'s Donor-Advised Fund</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>Email_Body_Text</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>

    <!-- Update Form_Sent_Date__c -->
    <recordUpdates>
        <name>Update_Form_Sent_Date</name>
        <label>Update Form Sent Date</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <faultConnector>
            <targetReference>Error_Handler_Update_Date</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Form_Sent_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>

    <!-- Email Body Text Formula -->
    <textTemplates>
        <name>Email_Body_Text</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear {!$Record.Contact.Name},

Thank you for speaking with us regarding the Donor-Advised Fund account held by {!$Record.Account.Name}. As discussed during our conversation, we are pleased to provide you with the Succession Recommendation process to formalize your pathway selection.

YOUR OPTIONS (as discussed):
We reviewed the three pathway options available to you:

1. FINAL GRANT TO CHARITY
   Direct the account balance as charitable grants to organizations of your choice

2. TRANSFER TO NEW DAF ACCOUNT
   Become the new account holder and continue charitable giving

3. DISCLAIM SUCCESSOR RIGHTS
   Decline your rights, and the account will be handled per organizational policy

NEXT STEPS:
We will follow up with you via phone within the next 3-5 business days to complete the pathway selection process and collect any necessary documentation.

If you have specific charities in mind for grants, or questions about the new account setup process, please have that information ready when we speak.

REQUIRED DOCUMENTS (please gather):
Regardless of which pathway you select, you will need:
• Certified copy of death certificate
• Government-issued photo ID (driver's license or passport)

Additional documents may be required depending on your pathway selection.

SUPPORT:
If you have any questions before our follow-up call, please contact us:
• Phone: 1-800-746-2227
• Case Number: {!$Record.CaseNumber}

We are here to support you through this process.

Warm regards,

{!$Record.Owner.Name}
Estate Administration Team
DAFGiving360</text>
    </textTemplates>

    <!-- Error Handler Subflow Calls -->
    <subflows>
        <name>Error_Handler_Send_Email</name>
        <label>Error Handler - Send Email</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <flowName>Flow_Error_Handler</flowName>
        <inputAssignments>
            <name>varErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varFlowName</name>
            <value>
                <stringValue>Case_Send_Succession_Form</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSeverity</name>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varErrorType</name>
            <value>
                <stringValue>Email</stringValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Error_Handler_Update_Date</name>
        <label>Error Handler - Update Date</label>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <flowName>Flow_Error_Handler</flowName>
        <inputAssignments>
            <name>varErrorMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varFlowName</name>
            <value>
                <stringValue>Case_Send_Succession_Form</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varSeverity</name>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varErrorType</name>
            <value>
                <stringValue>DML</stringValue>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
