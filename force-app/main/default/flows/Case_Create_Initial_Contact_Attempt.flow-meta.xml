<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description
  >Seeds Attempt 1 (Day 0) when Verification_Status__c becomes "Complete - Verified" on an Estate Administration case. Guards against duplicates via Contact_Attempt_Count__c IS NULL. Triggers on create or when the verification field changes. Adds Builder UI metadata for clarity.</description>
    <label>Case - Create Initial Contact Attempt</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Should_Start_Workflow</targetReference>
        </connector>
        <filterFormula>AND(
    RecordType.DeveloperName = &quot;EstateAdministration&quot;,
    TEXT({!$Record.Type}) = &quot;Named Successor Enactment&quot;,
    NOT(ISBLANK({!$Record.ContactId})),
    NOT(ISBLANK({!$Record.Successor__c})),
    NOT({!$Record.IsClosed}),
    OR(
        ISNEW(),
        ISCHANGED({!$Record.Verification_Status__c})
    )
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    
    <!-- Decision: Should Start Workflow? -->
    <decisions>
        <name>Check_Should_Start_Workflow</name>
        <label>Should Start Workflow?</label>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <defaultConnectorLabel>No - Exit</defaultConnectorLabel>
        <rules>
            <name>Start_Workflow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Verification_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Complete - Verified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Count__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attempt_1_Task</targetReference>
            </connector>
            <label>Yes - Start Workflow</label>
        </rules>
    </decisions>
    <status>Active</status>

    <!-- Create Attempt 1 Task (Day 0 - Immediate) -->
    <recordCreates>
        <name>Create_Attempt_1_Task</name>
        <label>Create Attempt 1 Task</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue
        >Succession Contact - Attempt 1 (Day 0)</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact_Attempt_Number__c</field>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Contact attempt for succession case.</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    
</Flow>
