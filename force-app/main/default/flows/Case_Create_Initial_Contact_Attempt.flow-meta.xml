<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description
  >Creates Attempt 1 task when case is created with Verification_Status__c='Complete - Verified' OR when agent clicks "Begin Succession Processing" Quick Action. Supports dual entry points: automatic (case creation) and manual (Quick Action). Prevents duplicate task creation via Contact_Attempt_Count__c check.</description>
    <label>Case - Create Initial Contact Attempt</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Should_Start_Workflow</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>EstateAdministration</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Named Successor Enactment</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    
    <!-- Decision: Should Start Workflow? -->
    <decisions>
        <name>Check_Should_Start_Workflow</name>
        <label>Should Start Workflow?</label>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <defaultConnectorLabel>No - Exit</defaultConnectorLabel>
        <rules>
            <name>Start_Workflow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Verification_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Complete - Verified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Count__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attempt_1_Task</targetReference>
            </connector>
            <label>Yes - Start Workflow</label>
        </rules>
    </decisions>
    <status>Active</status>

    <!-- Create Attempt 1 Task (Day 0 - Immediate) -->
    <recordCreates>
        <name>Create_Attempt_1_Task</name>
        <label>Create Attempt 1 Task</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <connector>
            <targetReference>Update_Case_Attempt_Count</targetReference>
        </connector>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue
        >Succession Contact - Attempt 1 (Day 0)</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact_Attempt_Number__c</field>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue
        >Initial contact attempt (Day 0). Agent can complete this task immediately.</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <!-- Update Case Contact_Attempt_Count__c -->
    <recordUpdates>
        <name>Update_Case_Attempt_Count</name>
        <label>Update Case Attempt Count</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <inputAssignments>
            <field>Contact_Attempt_Count__c</field>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
</Flow>
