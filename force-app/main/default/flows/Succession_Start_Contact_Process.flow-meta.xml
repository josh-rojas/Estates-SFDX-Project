<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description
  >Starts the successor contact process automatically when a case is created.</description>
    <label>Succession - Start Contact Process</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Should_Start_Workflow</targetReference>
        </connector>
        <filterFormula>AND(
    RecordType.DeveloperName = &quot;EstateAdministration&quot;,
    TEXT({!$Record.Type}) = &quot;Named Successor Enactment&quot;,
    NOT(ISBLANK({!$Record.ContactId})),
    NOT(ISBLANK({!$Record.Successor__c})),
    NOT({!$Record.IsClosed})
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <!-- Decision: Check for Duplicate Prevention -->
    <decisions>
        <name>Check_Should_Start_Workflow</name>
        <label>No Tasks Created Yet?</label>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <defaultConnectorLabel>Already Started - Exit</defaultConnectorLabel>
        <rules>
            <name>Start_Workflow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Count__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attempt_1_Via_Apex</targetReference>
            </connector>
            <label>Yes - Create First Task</label>
        </rules>
    </decisions>
    <status>Active</status>

    <!-- Action Call: Create Attempt 1 Task (Day 0 - Immediate) -->
    <actionCalls>
        <name>Create_Attempt_1_Via_Apex</name>
        <label>Create Attempt 1 (Day 0)</label>
        <locationX>50</locationX>
        <locationY>150</locationY>
        <actionName>SuccessionTaskCreator</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>attemptNumber</name>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>daysOffset</name>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>caseCreatedDate</name>
            <value>
                <elementReference>$Record.CreatedDate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SuccessionTaskCreator</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>

</Flow>
