<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description
  >Schedules the next successor contact attempt after completing the current one.</description>
    <label>Succession - Schedule Next Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parent_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Contact_Attempt_Number__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>

    <!-- Get Parent Case -->
    <recordLookups>
        <name>Get_Parent_Case</name>
        <label>Get Parent Case</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Contact_Established</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Check_If_Contact_Established</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- Decision: Check If Contact Established -->
    <decisions>
        <name>Check_If_Contact_Established</name>
        <label>Check If Contact Established</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>Contact Not Established</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Check_Attempt_Number</targetReference>
        </defaultConnector>
        <rules>
            <name>Contact_Already_Established</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_Parent_Case.Contact_Established__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Contact Already Established</label>
            <!-- Exit flow - no more tasks needed -->
        </rules>
    </decisions>

    <!-- Decision: Check Attempt Number -->
    <decisions>
        <name>Check_Attempt_Number</name>
        <label>Check Attempt Number</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <defaultConnectorLabel>Invalid Attempt</defaultConnectorLabel>
        <rules>
            <name>Is_Attempt_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attempt_2_Via_Apex</targetReference>
            </connector>
            <label>Is Attempt 1</label>
        </rules>
        <rules>
            <name>Is_Attempt_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attempt_3_Via_Apex</targetReference>
            </connector>
            <label>Is Attempt 2</label>
        </rules>
        <rules>
            <name>Is_Attempt_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attempt_4_Via_Apex</targetReference>
            </connector>
            <label>Is Attempt 3</label>
        </rules>
        <rules>
            <name>Is_Attempt_4</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Attempt_5_Via_Apex</targetReference>
            </connector>
            <label>Is Attempt 4</label>
        </rules>
        <rules>
            <name>Is_Attempt_5</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Attempt_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <label>Is Attempt 5 (Exit)</label>
            <!-- No connector: terminal attempt, exit flow -->
        </rules>
    </decisions>

    <!-- Action Call: Create Attempt 2 (Day 5) -->
    <actionCalls>
        <name>Create_Attempt_2_Via_Apex</name>
        <label>Create Attempt 2 (Day 5)</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <actionName>SuccessionTaskCreator</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>Get_Parent_Case.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>attemptNumber</name>
            <value>
                <numberValue>2.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>daysOffset</name>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>caseCreatedDate</name>
            <value>
                <elementReference>Get_Parent_Case.CreatedDate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SuccessionTaskCreator</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>

    <!-- Action Call: Create Attempt 3 (Day 35) -->
    <actionCalls>
        <name>Create_Attempt_3_Via_Apex</name>
        <label>Create Attempt 3 (Day 35)</label>
        <locationX>150</locationX>
        <locationY>400</locationY>
        <actionName>SuccessionTaskCreator</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>Get_Parent_Case.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>attemptNumber</name>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>daysOffset</name>
            <value>
                <numberValue>35.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>caseCreatedDate</name>
            <value>
                <elementReference>Get_Parent_Case.CreatedDate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SuccessionTaskCreator</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>

    <!-- Action Call: Create Attempt 4 (Day 65) -->
    <actionCalls>
        <name>Create_Attempt_4_Via_Apex</name>
        <label>Create Attempt 4 (Day 65)</label>
        <locationX>250</locationX>
        <locationY>400</locationY>
        <actionName>SuccessionTaskCreator</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>Get_Parent_Case.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>attemptNumber</name>
            <value>
                <numberValue>4.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>daysOffset</name>
            <value>
                <numberValue>65.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>caseCreatedDate</name>
            <value>
                <elementReference>Get_Parent_Case.CreatedDate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SuccessionTaskCreator</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>

    <!-- Action Call: Create Attempt 5 (Day 95) -->
    <actionCalls>
        <name>Create_Attempt_5_Via_Apex</name>
        <label>Create Attempt 5 (Day 95)</label>
        <locationX>350</locationX>
        <locationY>400</locationY>
        <actionName>SuccessionTaskCreator</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>Get_Parent_Case.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>attemptNumber</name>
            <value>
                <numberValue>5.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>daysOffset</name>
            <value>
                <numberValue>95.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>caseCreatedDate</name>
            <value>
                <elementReference>Get_Parent_Case.CreatedDate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SuccessionTaskCreator</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
</Flow>
