<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Has_Open_Child_True</name>
        <label>Set Has Open Child = True</label>
        <locationX>374</locationX>
        <locationY>674</locationY>
        <assignmentItems>
            <assignToReference>varHasOpenChild</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Children</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>All_Children_Complete</name>
        <label>All Children Complete?</label>
        <locationX>176</locationX>
        <locationY>674</locationY>
        <defaultConnectorLabel>Has Open Children</defaultConnectorLabel>
        <rules>
            <name>All_Closed_or_Canceled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHasOpenChild</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Parent_Case_Closed</targetReference>
            </connector>
            <label>All Closed or Canceled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Parent_Case_Found</name>
        <label>Parent Case Found?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>No Parent Found</defaultConnectorLabel>
        <rules>
            <name>Parent_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_All_Child_Cases</targetReference>
            </connector>
            <label>Parent Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Child_Is_Open</name>
        <label>Check If Child Is Open</label>
        <locationX>374</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Children</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Child Is Complete</defaultConnectorLabel>
        <rules>
            <name>Child_Still_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Loop_Through_Children.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >Loop_Through_Children.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Canceled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Has_Open_Child_True</targetReference>
            </connector>
            <label>Child Still Open</label>
        </rules>
    </decisions>
    <description
  >Monitors child case status changes and automatically closes the parent Multi-Account Succession Master case when all child Named Successor Enactment cases reach terminal status (Closed or Canceled).</description>
    <environments>Default</environments>
    <interviewLabel
  >Case: Parent Closure Handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case: Parent Closure Handler</label>
    <loops>
        <name>Loop_Through_Children</name>
        <label>Loop Through Children</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <collectionReference>Get_All_Child_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_If_Child_Is_Open</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>All_Children_Complete</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Child_Cases</name>
        <label>Get All Child Cases</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Children</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Loop_Through_Children</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordType.DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>EstateAdministration</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Type</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Parent_Case</name>
        <label>Get Parent Case</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Parent_Case_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Parent_Case_Found</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Multi-Account Succession Master</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Type</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Parent_Case_Closed</name>
        <label>Update Parent Case to Closed</label>
        <locationX>176</locationX>
        <locationY>782</locationY>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Parent_Case.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Execution_Status__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parent_Case</targetReference>
        </connector>
        <filterFormula>AND(
    RecordType.DeveloperName = &quot;EstateAdministration&quot;,
    TEXT({!$Record.Type}) = &quot;Named Successor Enactment&quot;,
    NOT(ISBLANK({!$Record.ParentId})),
    ISCHANGED({!$Record.Status}),
    OR(
        TEXT({!$Record.Status}) = &quot;Closed&quot;,
        TEXT({!$Record.Status}) = &quot;Canceled&quot;
    )
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Inactive</status>
    <variables>
        <name>varHasOpenChild</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
