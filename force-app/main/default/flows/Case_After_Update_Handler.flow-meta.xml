<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>CONSOLIDATED FLOW (v1.1): Handles all Case after-update automation for Estate Administration succession cases. Combines Status field coordination + Chatter feed notifications into single flow for performance optimization. Replaces deprecated flows: Case_Status_Coordination and Case_Succession_Segment_Transition.

TRIGGERS ON: Case UPDATE for Estate Administration cases (not closed)

WHAT IT DOES:
• Updates Case.Status based on workflow phase transitions (4-phase model)
• Posts Chatter feed updates when key milestones reached (aids demos &amp; agent handoffs)
• Handles 4 phase transitions: Contact Cadence → Pathway Selection → Pathway Execution → Case Closure

PHASE TRANSITIONS MONITORED:
1. Verification Complete (auto) → Status = "In Progress" (no Chatter - silent)
2. Contact Established → Status = "Awaiting Response" + Chatter post
3. Form Completed → Status = "In Review" + Chatter post with pathway name
4. Pathway Execution Started → Status = "In Progress" (no Chatter - tasks visible)
5. Execution Complete → Status = "Closed" (no Chatter - case closure self-evident)

PERFORMANCE: Consolidates 2 flows into 1 = 24% reduction in flow executions per case lifecycle

DEPENDENCIES:
• SuccessionChatterPoster.cls - Invocable class for standardized Chatter posts
• Contact_Established__c, Form_Completed_Date__c, Pathway_Confirmed__c, Execution_Status__c fields

RELATED FLOWS:
• Task_Succession_Contact_Update - Sets Contact_Established__c when task marked YES
• Case_Create_Initial_Contact_Attempt - Creates first contact task on case creation

VERSION HISTORY:
• v1.1 (Oct 2025) - Created consolidated flow for performance optimization
• Replaces: Case_Status_Coordination + Case_Succession_Segment_Transition (deprecated)</description>
    <environments>Default</environments>
    <interviewLabel
  >Case: After Update Handler {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case: After Update Handler</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>

    <!-- MAIN DECISION: Which Phase Transition Occurred? -->
    <decisions>
        <name>Check_Phase_Transitions</name>
        <label>Check Phase Transitions</label>
        <locationX>302</locationX>
        <locationY>144</locationY>
        <defaultConnectorLabel>No Status Change Needed</defaultConnectorLabel>

        <!-- PHASE 1: Verification Complete (Auto-start in v1.1) -->
        <rules>
            <name>Phase_1_Verification_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Verification_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Verification_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Complete - Verified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference
        >Update_Status_to_In_Progress_Phase1</targetReference>
            </connector>
            <label>Phase 1: Verification Complete</label>
        </rules>

        <!-- PHASE 2: Contact Established + Form Sent -->
        <rules>
            <name>Phase_2_Contact_Established</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Established__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Contact_Established__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Form_Sent_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference
        >Update_Status_to_Awaiting_Response</targetReference>
            </connector>
            <label>Phase 2: Contact Established</label>
        </rules>

        <!-- PHASE 3: Form Completed -->
        <rules>
            <name>Phase_3_Form_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Form_Completed_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Form_Completed_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_In_Review</targetReference>
            </connector>
            <label>Phase 3: Form Completed</label>
        </rules>

        <!-- PHASE 4: Pathway Execution Started -->
        <rules>
            <name>Phase_4_Pathway_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Pathway_Confirmed__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Pathway_Confirmed__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Not Selected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference
        >Update_Status_to_In_Progress_Phase4</targetReference>
            </connector>
            <label>Phase 4: Pathway Selected</label>
        </rules>

        <!-- PHASE 5: Execution Complete -->
        <rules>
            <name>Phase_5_Execution_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Execution_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Execution_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_Closed</targetReference>
            </connector>
            <label>Phase 5: Execution Complete</label>
        </rules>
    </decisions>

    <!-- RECORD UPDATES: Status Field Changes -->
    <recordUpdates>
        <name>Update_Status_to_In_Progress_Phase1</name>
        <label>Update Status to In Progress (Phase 1)</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <recordUpdates>
        <name>Update_Status_to_Awaiting_Response</name>
        <label>Update Status to Awaiting Response</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Post_Contact_Established_Chatter</targetReference>
        </connector>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Awaiting Response</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <recordUpdates>
        <name>Update_Status_to_In_Review</name>
        <label>Update Status to In Review</label>
        <locationX>302</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Post_Form_Completed_Chatter</targetReference>
        </connector>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>In Review</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <recordUpdates>
        <name>Update_Status_to_In_Progress_Phase4</name>
        <label>Update Status to In Progress (Phase 4)</label>
        <locationX>428</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <recordUpdates>
        <name>Update_Status_to_Closed</name>
        <label>Update Status to Closed</label>
        <locationX>554</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <!-- ACTION CALLS: Chatter Feed Posts (via Apex Invocable) -->
    <actionCalls>
        <name>Post_Contact_Established_Chatter</name>
        <label>Post Contact Established Chatter</label>
        <locationX>176</locationX>
        <locationY>468</locationY>
        <actionName>SuccessionChatterPoster</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>transitionType</name>
            <value>
                <stringValue>CONTACT_ESTABLISHED</stringValue>
            </value>
        </inputParameters>
        <nameSegment>SuccessionChatterPoster</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>

    <actionCalls>
        <name>Post_Form_Completed_Chatter</name>
        <label>Post Form Completed Chatter</label>
        <locationX>302</locationX>
        <locationY>468</locationY>
        <actionName>SuccessionChatterPoster</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>transitionType</name>
            <value>
                <stringValue>FORM_COMPLETED</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>pathwayName</name>
            <value>
                <elementReference>$Record.Pathway_Confirmed__c</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SuccessionChatterPoster</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>

    <!-- FLOW TRIGGER: After Update on Estate Administration Cases -->
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Phase_Transitions</targetReference>
        </connector>
        <filterFormula>AND(
    RecordType.DeveloperName = &quot;EstateAdministration&quot;,
    TEXT({!$Record.Type}) = &quot;Named Successor Enactment&quot;,
    IsClosed = FALSE
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Inactive</status>
</Flow>
