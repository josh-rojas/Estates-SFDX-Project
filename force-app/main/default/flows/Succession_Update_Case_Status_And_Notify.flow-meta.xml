    <decisions>
        <name>Check_Phase_Transitions</name>
        <label>Check Phase Transitions</label>
        <locationX>302</locationX>
        <locationY>144</locationY>
        <defaultConnectorLabel>No Status Change Needed</defaultConnectorLabel>
        <rules>
            <name>Phase_1_Verification_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Verification_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Verification_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Complete - Verified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference
        >Update_Status_to_In_Progress_Phase1</targetReference>
            </connector>
            <label>Phase 1: Verification Complete</label>
        </rules>
        <rules>
            <name>Phase_2_Contact_Established</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Contact_Established__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Contact_Established__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Form_Sent_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference
        >Update_Status_to_Awaiting_Response</targetReference>
            </connector>
            <label>Phase 2: Contact Established</label>
        </rules>
        <rules>
            <name>Phase_3_Form_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Form_Completed_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Form_Completed_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_In_Review</targetReference>
            </connector>
            <label>Phase 3: Form Completed</label>
        </rules>
        <rules>
            <name>Phase_4_Pathway_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Pathway_Confirmed__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Pathway_Confirmed__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Not Selected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference
        >Update_Status_to_In_Progress_Phase4</targetReference>
            </connector>
            <label>Phase 4: Pathway Selected</label>
        </rules>
        <rules>
            <name>Phase_5_Execution_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Execution_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.Execution_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_Closed</targetReference>
            </connector>
            <label>Phase 5: Execution Complete</label>
        </rules>
    </decisions>
