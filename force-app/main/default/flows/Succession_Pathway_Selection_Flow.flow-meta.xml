<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>

    <!-- Choice Options -->
    <choices>
        <name>Choice_Disclaim</name>
        <choiceText
    >Disclaim Assets - Successor declines the account, assets handled per fund bylaws</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Disclaim Assets</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Final_Grant</name>
        <choiceText
    >Final Grant - Successor directs account balance as final charitable grant</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Final Grant</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_New_DAF</name>
        <choiceText
    >New DAF Account - Successor becomes new donor, account transferred to their name</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>New DAF Account</stringValue>
        </value>
    </choices>

    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{"location":"top","type":"simple"}</stringValue>
        </value>
    </customProperties>

    <!-- Decisions -->
    <decisions>
        <name>Confirm_Contact_Made</name>
        <label>Confirm Contact Made</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Contact_Not_Established_Warning</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Confirmed</defaultConnectorLabel>
        <rules>
            <name>Contact_Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Confirm_Contact_Checkbox</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pathway_Selection_Screen</targetReference>
            </connector>
            <label>Contact Confirmed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validate_Pathway_Selected</name>
        <label>Validate Pathway Selected</label>
        <locationX>50</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Pathway_Selection_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Selection</defaultConnectorLabel>
        <rules>
            <name>Pathway_Is_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Pathway_Choice</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Document_Upload_Screen</targetReference>
            </connector>
            <label>Pathway Is Selected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Verify_Contact_Established</name>
        <label>Verify Contact Established</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Contact_Not_Established_Warning</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contact Not Established</defaultConnectorLabel>
        <rules>
            <name>Contact_Already_Established</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_Case_Record.Contact_Established__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pathway_Selection_Screen</targetReference>
            </connector>
            <label>Contact Already Established</label>
        </rules>
    </decisions>

    <description
  >Agent-guided Screen Flow for recording succession pathway selection. Supports verbal conversations, paper form processing, and document upload. More comprehensive than Quick Action for complex scenarios. BRD-aligned.</description>
    <environments>Default</environments>

    <!-- Formulas -->
    <formulas>
        <name>Formula_Append_Notes</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!Additional_Notes}),
  {!Get_Case_Record.Description},
  {!Get_Case_Record.Description} &amp; BR() &amp; BR() &amp;
  "--- Succession Pathway Selection (" &amp; TEXT(NOW()) &amp; ") ---" &amp; BR() &amp;
  "Pathway: " &amp; {!Pathway_Choice} &amp; BR() &amp;
  IF({!Paper_Form_Received}, "Paper form processed" &amp; BR(), "") &amp;
  "Notes: " &amp; {!Additional_Notes}
)</expression>
    </formulas>
    <formulas>
        <name>Formula_Due_Date</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 3</expression>
    </formulas>
    <formulas>
        <name>Formula_Task_Description</name>
        <dataType>String</dataType>
        <expression
    >"Successor has selected: " &amp; {!Pathway_Choice} &amp; BR() &amp; BR() &amp;
"Required documents based on pathway:" &amp; BR() &amp;
CASE({!Pathway_Choice},
  "Final Grant",
    "• Death certificate" &amp; BR() &amp;
    "• ID verification" &amp; BR() &amp;
    "• Grant direction form",
  "New DAF Account",
    "• Death certificate" &amp; BR() &amp;
    "• ID verification" &amp; BR() &amp;
    "• New account paperwork" &amp; BR() &amp;
    "• W-9 form",
  "Disclaim Assets",
    "• Formal disclaimer document" &amp; BR() &amp;
    "• Death certificate",
  "• Contact successor for pathway confirmation"
) &amp; BR() &amp; BR() &amp;
"Next Phase: Document Collection (Phase 3)"</expression>
    </formulas>
    <formulas>
        <name>Formula_Task_Subject</name>
        <dataType>String</dataType>
        <expression
    >"Collect Documents: " &amp; {!Pathway_Choice} &amp; " Pathway"</expression>
    </formulas>

    <interviewLabel
  >Succession Pathway Selection {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Succession Pathway Selection Flow</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>

    <!-- Record Creates -->
    <recordCreates>
        <name>Create_Follow_Up_Task</name>
        <label>Create Follow-Up Task</label>
        <locationX>50</locationX>
        <locationY>998</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Formula_Task_Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>Formula_Due_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Formula_Task_Description</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

    <!-- Record Lookups -->
    <recordLookups>
        <name>Get_Case_Record</name>
        <label>Get Case Record</label>
        <locationX>50</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verify_Contact_Established</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <!-- Record Updates -->
    <recordUpdates>
        <name>Update_Case_Fields</name>
        <label>Update Case Fields</label>
        <locationX>50</locationX>
        <locationY>890</locationY>
        <connector>
            <targetReference>Create_Follow_Up_Task</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Pathway_Confirmed__c</field>
            <value>
                <elementReference>Pathway_Choice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact_Established__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact_Established_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Formula_Append_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>

    <!-- Screens -->
    <screens>
        <name>Contact_Not_Established_Warning</name>
        <label>Contact Not Established Warning</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Confirm_Contact_Made</targetReference>
        </connector>
        <fields>
            <name>Warning_Text</name>
            <fieldText
      >&lt;p&gt;&lt;strong style="color: rgb(194, 57, 52);"&gt;⚠️ IMPORTANT: Contact Not Yet Established&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Per BRD requirements, you must have direct verbal contact with the successor before recording their pathway selection.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please confirm you have:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Spoken directly with the successor&lt;/li&gt;&lt;li&gt;Explained all three pathway options&lt;/li&gt;&lt;li&gt;Received their confirmed selection&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;If you have NOT had this conversation, please use the &lt;strong&gt;Quick Action&lt;/strong&gt; after the call instead.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Confirm_Contact_Checkbox</name>
            <dataType>Boolean</dataType>
            <fieldText
      >I confirm I have had direct verbal contact with the successor and explained all pathway options</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Document_Upload_Screen</name>
        <label>Document Upload Screen</label>
        <locationX>50</locationX>
        <locationY>782</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Case_Fields</targetReference>
        </connector>
        <fields>
            <name>Upload_Instructions</name>
            <fieldText
      >&lt;p&gt;&lt;strong&gt;Document Upload (Optional)&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;If you have paper forms, signed documents, or other supporting files, you can upload them here. Documents will be attached to the Case record.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Common documents:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Signed succession recommendation form&lt;/li&gt;&lt;li&gt;Death certificate copy&lt;/li&gt;&lt;li&gt;ID verification documents&lt;/li&gt;&lt;li&gt;Handwritten notes from conversation&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;You can also upload documents later from the Case record page.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>File_Upload</name>
            <extensionName>forceContent:fileUpload</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Upload Supporting Documents</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>multiple</name>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn
      >UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Screen</name>
        <label>Error Screen</label>
        <locationX>314</locationX>
        <locationY>890</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Message</name>
            <fieldText
      >&lt;p style="text-align: center;"&gt;&lt;span style="font-size: 18px; color: rgb(194, 57, 52);"&gt;⚠️ Error Occurred&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;An error occurred while processing the pathway selection. Please try again or contact your Salesforce administrator if the problem persists.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Error Details:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Pathway_Selection_Screen</name>
        <label>Pathway Selection Screen</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Validate_Pathway_Selected</targetReference>
        </connector>
        <fields>
            <name>Screen_Title</name>
            <fieldText
      >&lt;p style="text-align: center;"&gt;&lt;strong style="font-size: 18px;"&gt;Record Succession Pathway Selection&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Instructions_Text</name>
            <fieldText
      >&lt;p&gt;&lt;strong&gt;Agent Instructions:&lt;/strong&gt; Use this flow to record the successor's pathway choice after a verbal conversation or when processing paper forms.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;This flow supports:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Complex verbal conversations requiring guidance&lt;/li&gt;&lt;li&gt;Paper form transcription and upload&lt;/li&gt;&lt;li&gt;Additional documentation capture&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;For simple, straightforward selections, use the &lt;strong&gt;Quick Action&lt;/strong&gt; instead.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Pathway_Choice</name>
            <choiceReferences>Choice_Final_Grant</choiceReferences>
            <choiceReferences>Choice_New_DAF</choiceReferences>
            <choiceReferences>Choice_Disclaim</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select Succession Pathway</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Additional_Notes</name>
            <fieldText>Additional Notes (optional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <helpText
      >Capture any additional context from the conversation or paper form that may be relevant for processing.</helpText>
        </fields>
        <fields>
            <name>Paper_Form_Received</name>
            <dataType>Boolean</dataType>
            <fieldText>Paper form received and processed</fieldText>
            <fieldType>InputField</fieldType>
            <helpText
      >Check this if you are transcribing from a physical paper form</helpText>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Success Screen</label>
        <locationX>50</locationX>
        <locationY>1106</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_Message</name>
            <fieldText
      >&lt;p style="text-align: center;"&gt;&lt;span style="font-size: 18px; color: rgb(11, 130, 71);"&gt;✓ Succession Pathway Recorded Successfully&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align: center;"&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Pathway Selected:&lt;/strong&gt; {!Pathway_Choice}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Contact Established:&lt;/strong&gt; Yes&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Next Phase:&lt;/strong&gt; Document Collection (Phase 3)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;A follow-up task has been created for document collection. The contact cadence automation has been stopped.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case_Record</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>

    <!-- Variables -->
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
