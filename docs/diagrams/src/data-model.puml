@startuml
' Inlined SFDC theme (avoid external include for IDE renderers)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 6
skinparam DefaultFontName "Salesforce Sans","Helvetica Neue","Arial","Sans-Serif"
skinparam DefaultFontSize 14
skinparam DefaultFontColor #3E3E3C
skinparam LineColor #D0D5DA
skinparam ArrowColor #0176D3
skinparam ArrowThickness 1
skinparam NoteBackgroundColor #F3F2F2
skinparam NoteBorderColor #D0D5DA
skinparam NoteFontColor #3E3E3C
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleBorderColor #D0D5DA
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #D0D5DA
skinparam ComponentFontColor #3E3E3C
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #D0D5DA
skinparam ClassFontColor #3E3E3C
skinparam classAttributeIconSize 0
skinparam ObjectBackgroundColor #FFFFFF
skinparam ObjectBorderColor #D0D5DA
skinparam StateBackgroundColor #FFFFFF
skinparam StateBorderColor #D0D5DA
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #D0D5DA
skinparam SequenceLifeLineBorderColor #D0D5DA
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #D0D5DA
skinparam ActorBorderColor #D0D5DA
skinparam ActorBackgroundColor #FFFFFF
left to right direction
title Succession Data Model (Salesforce Notation)

skinparam linetype ortho

entity "Account" as Account {
  Id
  Name
  IsPersonAccount
  PersonContactId
  PersonEmail
}

entity "Contact" as Contact {
  Id
  Email
}

entity "FinancialAccount" as FA {
  Id
  Name
}

entity "FinancialAccountRole" as FAR {
  Id
  Role
  FinServ__RelatedContact__c
  FinServ__RelatedAccount__c
  SuccessorAllocation__c
}

entity "Case (Estate Administration)" as CaseObj {
  Id
  Type
  ParentId
  Pathway_Confirmed__c
  Verification_Status__c
  Contact_Established__c
  Execution_Status__c
}

entity "Task" as Task {
  Id
  Contact_Attempt_Number__c
  ActivityDate
  Succession_Contact_Established__c
}

Account ||--o{ CaseObj : primary account
CaseObj ||--o{ Task : contact attempts
FA ||--o{ FAR : roles
Account ||--o{ FA : owns
FAR }o--|| Contact : person role\n(FinServ__RelatedContact__c)
FAR }o--|| Account : org role\n(FinServ__RelatedAccount__c)
CaseObj }o--o{ CaseObj : parent-child\n(multi-successor)

note right of FAR
For Person Accounts, FAR.FinServ__RelatedContact__c -> Account.PersonContactId
end note

@enduml
