@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 6
skinparam DefaultFontName "Salesforce Sans","Helvetica Neue","Arial","Sans-Serif"
skinparam DefaultFontSize 14
skinparam DefaultFontColor #3E3E3C
skinparam LineColor #D0D5DA
skinparam ArrowColor #0176D3
skinparam ArrowThickness 1
skinparam NoteBackgroundColor #F3F2F2
skinparam NoteBorderColor #D0D5DA
skinparam NoteFontColor #3E3E3C
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleBorderColor #D0D5DA
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #D0D5DA
left to right direction
skinparam linetype ortho
title Succession 5-Phase Workflow
start
:Verify identity and documentation; 
if (Quick Action:\n"Begin Succession Processing" clicked?) then (yes)
  :Create Day 0 task; 
  :Contact Cadence (Days 0,5,35,65,95);
  if (Contact established?) then (yes)
    :Send public form link; 
    :Successor selects pathway; 
    :Set Pathway_Confirmed__c; 
    :Create pathway tasks (4-5) via\nSuccessionTaskGenerator;
    :Execute tasks; 
    :Status coordination updates Case.Status; 
  else (no)
    :Stop cadence at Day 95; 
    stop
  endif
else (no)
  stop
endif
stop
note right
Email validation always enforced before sending:
- HasOptedOutOfEmail
- Valid email format
- Email exists
end note
@enduml
