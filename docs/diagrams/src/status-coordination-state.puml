@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 6
skinparam DefaultFontName "Salesforce Sans","Helvetica Neue","Arial","Sans-Serif"
skinparam DefaultFontSize 14
skinparam DefaultFontColor #3E3E3C
skinparam LineColor #D0D5DA
skinparam ArrowColor #0176D3
skinparam ArrowThickness 1
skinparam NoteBackgroundColor #F3F2F2
skinparam NoteBorderColor #D0D5DA
skinparam NoteFontColor #3E3E3C
skinparam StateBackgroundColor #FFFFFF
skinparam StateBorderColor #D0D5DA
left to right direction
skinparam linetype ortho
title Case Status Coordination
[*] --> New
New --> In_Progress : Verification_Status__c =\n"Complete - Verified"
In_Progress --> Awaiting_Response : Contact_Established__c = true\nAND Form_Sent_Date__c != null
Awaiting_Response --> In_Review : Form_Completed_Date__c != null
In_Review --> In_Progress : Pathway_Confirmed__c != "Not Selected"
In_Progress --> Closed : Execution_Status__c = "Completed"
@enduml
