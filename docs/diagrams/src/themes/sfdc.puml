' Salesforce (SLDS-inspired) light theme for PlantUML
' Aims to match Salesforce docs styling and colors

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 6

' Typography
skinparam DefaultFontName "Salesforce Sans","Helvetica Neue","Arial","Sans-Serif"
skinparam DefaultFontSize 14
skinparam DefaultFontColor #3E3E3C  ' SLDS text-color

' Lines and arrows
skinparam LineColor #D0D5DA        ' SLDS border color
skinparam ArrowColor #0176D3       ' SLDS brand blue
skinparam ArrowThickness 1

' Notes / callouts
skinparam NoteBackgroundColor #F3F2F2
skinparam NoteBorderColor #D0D5DA
skinparam NoteFontColor #3E3E3C

' Core shapes
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleBorderColor #D0D5DA

skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #D0D5DA
skinparam ComponentFontColor #3E3E3C

skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #D0D5DA
skinparam ClassFontColor #3E3E3C
skinparam classAttributeIconSize 0

skinparam ObjectBackgroundColor #FFFFFF
skinparam ObjectBorderColor #D0D5DA

skinparam StateBackgroundColor #FFFFFF
skinparam StateBorderColor #D0D5DA

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #D0D5DA

' Sequence diagram specifics
skinparam SequenceLifeLineBorderColor #D0D5DA
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #D0D5DA
skinparam ActorBorderColor #D0D5DA
skinparam ActorBackgroundColor #FFFFFF
