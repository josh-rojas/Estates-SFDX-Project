' Dark theme for PlantUML diagrams (optimized for dark backgrounds)
skinparam backgroundColor transparent
skinparam shadowing false
skinparam roundcorner 8

' Global font and line colors
skinparam DefaultFontColor #E5E7EB
skinparam ArrowColor #93C5FD
skinparam LineColor #9CA3AF

' Notes
skinparam NoteBackgroundColor #1F2937
skinparam NoteBorderColor #4B5563
skinparam NoteFontColor #D1D5DB

' Packages / Rectangles
skinparam PackageBackgroundColor #0B1220
skinparam PackageBorderColor #4B5563
skinparam RectangleBackgroundColor #111827
skinparam RectangleBorderColor #4B5563

' Components
skinparam ComponentBackgroundColor #111827
skinparam ComponentBorderColor #4B5563
skinparam ComponentFontColor #E5E7EB

' Classes
skinparam ClassBackgroundColor #111827
skinparam ClassBorderColor #4B5563
skinparam ClassFontColor #E5E7EB

' Objects
skinparam ObjectBackgroundColor #111827
skinparam ObjectBorderColor #4B5563

' States
skinparam StateBackgroundColor #111827
skinparam StateBorderColor #4B5563

' Activities
skinparam ActivityBackgroundColor #111827
skinparam ActivityBorderColor #4B5563

' Sequence / Participants
skinparam SequenceLifeLineBorderColor #4B5563
skinparam SequenceLifeLineBackgroundColor #111827
skinparam ParticipantBackgroundColor #111827
skinparam ParticipantBorderColor #374151
skinparam ActorBorderColor #374151
skinparam ActorBackgroundColor #111827

