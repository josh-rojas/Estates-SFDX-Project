{
  "name": "salesforce-app",
  "private": true,
  "version": "1.0.0",
  "description": "Salesforce App",
  "scripts": {
    "// === VALIDATION SCRIPTS (Read-only checks) ===": "",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint **/lwc/**/*.js",
    "lint:prettier": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "lint:apex": "sf scanner run --target \"force-app/main/default/classes/**/*.cls,force-app/main/default/triggers/**/*.trigger\" --format table",
    "// === FORMATTING SCRIPTS (Auto-fix) ===": "",
    "format": "npm run format:prettier && npm run format:eslint",
    "format:eslint": "eslint --fix **/lwc/**/*.js",
    "format:prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "// === TESTING SCRIPTS ===": "",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "// === COMBINED WORKFLOWS ===": "",
    "validate": "npm run lint && npm run test:unit",
    "validate:ci": "npm run lint:eslint && npm run lint:prettier && npm run test:unit:coverage",
    "precommit:check": "npm run lint && npm run test:unit -- --bail --findRelatedTests",
    "// === LEGACY ALIASES (Use format:* instead) ===": "",
    "prettier": "npm run format:prettier",
    "prettier:verify": "npm run lint:prettier",
    "// === GIT HOOKS ===": "",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/prettier-config": "^0.0.4",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint --fix"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
